        <Media Id="1" Cabinet="app.cab" EmbedCab="yes" />
        <Property Id="INSTALL_STARTMENU" Value="1" />
        <Property Id="INSTALL_DESKTOP" Value="1" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
        <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />
        <Property Id="ALLUSERS" Value="1" />
        <Property Id="REINSTALLMODE" Value="amus" />
        <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Iniciar OpenWave al terminar la instalación" />
        <Property Id="AUTOLAUNCHAPP" Secure="yes" />
        <Property Id="LAUNCHAPPARGS" Secure="yes" />
        <Property Id="WIX_UPGRADE_DETECTED" Secure="yes" />
        <Property Id="INSTALLED_WEBVIEW2_VERSION">
            <RegistrySearch Id="Webview2VersionSystemx86" Root="HKLM" Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" Win64="yes" />
            <RegistrySearch Id="Webview2VersionSystemx64" Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" Win64="yes" />
            <RegistrySearch Id="Webview2VersionUser" Root="HKCU" Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" Win64="yes" />
        </Property>
        <Property Id="INSTALLDIR">
            <RegistrySearch Id="PrevInstallDirWithName" Root="HKCU" Key="Software\soundwave\OpenWave" Name="InstallDir" Type="raw" Win64="yes" />
            <RegistrySearch Id="PrevInstallDirLegacyWithName" Root="HKCU" Key="Software\soundwave\SoundWave" Name="InstallDir" Type="raw" Win64="yes" />
            <RegistrySearch Id="PrevInstallDirNoName" Root="HKCU" Key="Software\soundwave\OpenWave" Type="raw" Win64="yes" />
            <RegistrySearch Id="PrevInstallDirLegacyNoName" Root="HKCU" Key="Software\soundwave\SoundWave" Type="raw" Win64="yes" />
        </Property>
        <UI>
            <Dialog Id="OptionsDlg" X="50" Y="50" Width="370" Height="270" Title="Opciones de instalación de [ProductName]">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner" TabSkip="no" Disabled="yes" />
                <Control Id="StartMenuCheck" Type="CheckBox" X="20" Y="56" Width="330" Height="18" Property="INSTALL_STARTMENU" Text="Crear un acceso directo en el menú inicio" CheckBoxValue="1" TabSkip="no" />
                <Control Id="DesktopCheck" Type="CheckBox" X="20" Y="82" Width="330" Height="18" Property="INSTALL_DESKTOP" Text="Crear un acceso directo en el escritorio" CheckBoxValue="1" TabSkip="no" />
                <Control Id="StartupCheck" Type="CheckBox" X="20" Y="108" Width="330" Height="18" Property="INSTALL_STARTUP" Text="Iniciar OpenWave con Windows" CheckBoxValue="1" TabSkip="no" />
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="&amp;Siguiente" TabSkip="no" Default="yes">
                    <Publish Event="AddLocal" Value="StartMenuShortcut">INSTALL_STARTMENU = "1"</Publish>
                    <Publish Event="Remove" Value="StartMenuShortcut">INSTALL_STARTMENU &lt;&gt; "1"</Publish>
                    <Publish Event="AddLocal" Value="DesktopShortcut">INSTALL_DESKTOP = "1"</Publish>
                    <Publish Event="Remove" Value="DesktopShortcut">INSTALL_DESKTOP &lt;&gt; "1"</Publish>
                    <Publish Event="AddLocal" Value="StartupShortcut">INSTALL_STARTUP = "1"</Publish>
                    <Publish Event="Remove" Value="StartupShortcut">INSTALL_STARTUP &lt;&gt; "1"</Publish>
                    <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
                </Control>
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Atrás" TabSkip="no">
                    <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancelar" TabSkip="no" Cancel="yes">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Text="Elija qué accesos directos desea crear." TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Text="{\WixUI_Font_Title}Opciones de instalación" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" TabSkip="yes" Disabled="yes" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" TabSkip="yes" Disabled="yes" />
                <Control Id="StartupHint" Type="Text" X="32" Y="130" Width="310" Height="30" Text="Solo para este usuario. Puede desactivarlo más adelante en Configuración de Windows &gt; Aplicaciones de inicio." TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="DataNote" Type="Text" X="20" Y="166" Width="330" Height="46" Text="La música descargada, la base de datos y las copias de seguridad se guardan en C:\ProgramData\OpenWave, no en Archivos de programa." TabSkip="yes" Transparent="yes" NoPrefix="yes" />
            </Dialog>
        </UI>
        <UIRef Id="WixUI_InstallDir" />
        <InstallExecuteSequence>
            <Custom Action="SetARPINSTALLLOCATION" After="CostFinalize" />
            <Custom Action="SetARPNOMODIFY" After="InstallValidate" />
            <Custom Action="InvokeBootstrapper" Before="InstallFinalize">NOT(REMOVE OR INSTALLED_WEBVIEW2_VERSION)</Custom>
            <Custom Action="LaunchApplication" After="InstallFinalize">AUTOLAUNCHAPP AND NOT Installed</Custom>
            <RemoveShortcuts>Installed AND NOT UPGRADINGPRODUCTCODE</RemoveShortcuts>
        </InstallExecuteSequence>
        <InstallUISequence>
            <Custom Action="SetARPINSTALLLOCATION" After="CostFinalize" />
        </InstallUISequence>
