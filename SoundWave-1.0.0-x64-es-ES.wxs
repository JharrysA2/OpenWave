                <Control Id="DataNote" Type="Text" X="20" Y="166" Width="330" Height="46" Text="La música descargada, la base de datos y los registros se guardan en %LOCALAPPDATA%\SoundWave, no en Archivos de programa." TabSkip="yes" Transparent="yes" NoPrefix="yes" />
