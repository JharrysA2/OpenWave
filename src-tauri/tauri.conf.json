{
  "productName": "OpenWave",
  "mainBinaryName": "OpenWave",
  "version": "1.0.0",
  "identifier": "com.soundwave.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "OpenWave",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765 https://*.ytimg.com https://*.googleusercontent.com; img-src 'self' https: data: blob: http://127.0.0.1:8765; media-src 'self' https: http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; script-src 'self'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "license": "GPL-3.0-or-later",
    "licenseFile": "../build/windows/licencia.txt",
    "icon": [
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/16x16.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/staging/backend": "backend",
      "../build/staging/runtime": "runtime",
      "../build/staging/ffmpeg": "ffmpeg",
      "../LICENSE": "LICENSE",
      "../build/windows/openwave-identity.msix": "openwave-identity.msix",
      "../build/windows/openwave-identity.cer": "openwave-identity.cer",
      "../packaging/appx/openwave-identity-ca.ps1": "openwave-identity-ca.ps1"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "wix": {
        "template": "windows/main.wxs",
        "upgradeCode": "25B18CFC-CFEF-5B7B-B931-92523BC6F856",
        "bannerPath": "../build/windows/banner.bmp",
        "dialogImagePath": "../build/windows/dialog.bmp",
        "language": {
          "es-ES": { "localePath": "windows/es-ES.wxl" }
        }
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}