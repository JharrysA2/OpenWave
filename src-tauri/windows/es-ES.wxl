<?xml version="1.0" encoding="utf-8"?>
<!--
  Localización es-ES del instalador MSI de SoundWave.

  Referenciado desde bundle.wix.language en src-tauri/tauri.conf.json (la ruta
  se resuelve contra src-tauri/ porque el bundler cambia el cwd a esa carpeta).

  Aquí solo van las cadenas PROPIAS:
    * Los identificadores por defecto de Tauri (default-locale-strings.xml):
      si faltaran, Tauri los auto-apendiciría en inglés al locale.wxl final.
    * Las del diálogo OptionsDlg (accesos directos) y de las features que
      añadimos en src-tauri/windows/main.wxs.

  Las del asistente de WixUI (Bienvenido, Licencia, Carpeta de destino,
  «Atrás»/«Siguiente»/«Cancelar»...) ya están en español dentro de
  WixUIExtension y se resuelven con -cultures:es-es;en-US.

  Codificación: el fichero es UTF-8 y el paquete declara Codepage 1252, así que
  todo el texto de aquí debe ser representable en CP-1252 (español normal [ok]).
-->
<WixLocalization Culture="es-es" Codepage="1252" xmlns="http://schemas.microsoft.com/wix/2006/localization">

    <!-- Identificadores por defecto de Tauri -->
    <String Id="TauriLanguage">3082</String>
    <String Id="TauriCodepage">1252</String>
    <String Id="LaunchApp">Iniciar SoundWave al terminar la instalación</String>
    <String Id="DowngradeErrorMessage">Ya está instalada una versión más reciente de SoundWave. Desinstálala para poder continuar.</String>
    <String Id="InstallAppFeature">Instala SoundWave en el equipo.</String>
    <String Id="PathEnvVarFeature">Añade la carpeta de instalación de SoundWave a la variable de entorno PATH del sistema, para poder lanzarlo desde cualquier ubicación.</String>

    <!-- Titulos de las features opcionales del OptionsDlg -->
    <String Id="FeatureStartMenu">Acceso directo en el menú inicio</String>
    <String Id="FeatureDesktop">Acceso directo en el escritorio</String>
    <String Id="FeatureStartup">Iniciar SoundWave con Windows</String>

    <!-- Diálogo OptionsDlg (src-tauri/windows/main.wxs) -->
    <String Id="OptionsDlg_Title">Opciones de instalación de [ProductName]</String>
    <String Id="OptionsDlgTitle">{\WixUI_Font_Title}Opciones de instalación</String>
    <String Id="OptionsDlgDescription">Elija qué accesos directos desea crear.</String>
    <String Id="OptionsDlgBannerBitmap">WixUI_Bmp_Banner</String>
    <String Id="OptionsDlgStartMenu">Crear un acceso directo en el menú inicio</String>
    <String Id="OptionsDlgDesktop">Crear un acceso directo en el escritorio</String>
    <String Id="OptionsDlgStartup">Iniciar SoundWave con Windows</String>
    <String Id="OptionsDlgStartupHint">Solo para este usuario. Puede desactivarlo más adelante en Configuración de Windows &gt; Aplicaciones de inicio.</String>
    <String Id="OptionsDlgNote">La música descargada, la base de datos y los registros se guardan en %LOCALAPPDATA%\SoundWave, no en Archivos de programa.</String>

</WixLocalization>
