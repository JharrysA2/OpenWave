<?if $(sys.BUILDARCH)="x86"?>
    <?define Win64 = "no" ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
    <?define IcaclsFolderId = "SystemFolder" ?>
<?elseif $(sys.BUILDARCH)="x64"?>
    <?define Win64 = "yes" ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
    <?define IcaclsFolderId = "System64Folder" ?>
<?elseif $(sys.BUILDARCH)="arm64"?>
    <?define Win64 = "yes" ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
    <?define IcaclsFolderId = "System64Folder" ?>
<?else?>
    <?error Unsupported value of sys.BUILDARCH=$(sys.BUILDARCH)?>
<?endif?>

<!--
    Plantilla MSI de OpenWave: copia de la por defecto de Tauri (tauri-cli
    bundler/wix/main.wxs) con estos cambios:

    1. Flujo de diálogos: ... InstallDirDlg -> OptionsDlg -> VerifyReadyDlg.
       El NewDialog a OptionsDlg se publica con Order="5" porque de varios
       NewDialog del mismo control SOLO se publica el de mayor orden (doc.
       MSI, ControlEvent table); así pisa al Order="4" de WixUI_InstallDir
       sin tocar la validación de ruta (misma condición WIXUI_*_VALID).
    2. OptionsDlg con tres casillas (Menú Inicio / Escritorio / Inicio con
       Windows) que traducen su estado a ADDLOCAL/REMOVE al pulsar Siguiente
       (eventos AddLocal/Remove, patrón canónico: las condiciones sobre
       <Feature> se evalúan en CostFinalize, ANTES de los diálogos, y no
       sirven para decidir desde la UI).
    3. El .exe (componente Path) se instala SIEMPRE en MainProgram: los
       accesos directos son opcionales, la app no.
    4. Componente nuevo CMP_StartupRun: entrada en el registro
       HKCU\...\CurrentVersion\Run para «Iniciar con Windows» (opcional,
       desmarcado por defecto). Patrón de claves HKCU idéntico al de los
       componentes de accesos directos que ya trae Tauri.
    5. RemoveFolder de INSTALLDIR movido al componente Path para que la
       carpeta se limpie aunque el usuario desmarque el Menú Inicio.

    El resto (WebView2, binarios, recursos, upgrade) es literal de Tauri.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product
            Id="*"
            Name="{{product_name}}"
            UpgradeCode="{{upgrade_code}}"
            Language="!(loc.TauriLanguage)"
            Manufacturer="{{manufacturer}}"
            Version="{{version}}">

        <Package Id="*"
                 Keywords="Installer"
                 InstallerVersion="450"
                 Languages="0"
                 Compressed="yes"
                 InstallScope="perMachine"
                 SummaryCodepage="!(loc.TauriCodepage)"/>

        <!-- https://docs.microsoft.com/en-us/windows/win32/msi/reinstallmode -->
        <!-- reinstall all files; rewrite all registry entries; reinstall all shortcuts -->
        <Property Id="REINSTALLMODE" Value="amus" />

        <!-- Auto launch app after installation, useful for passive mode which usually used in updates -->
        <Property Id="AUTOLAUNCHAPP" Secure="yes" />
        <!-- Property to forward cli args to the launched app to not lose those of the pre-update instance -->
        <Property Id="LAUNCHAPPARGS" Secure="yes" />

        <!-- ── Estado por defecto de las casillas del diálogo OptionsDlg ─────
             Debe coincidir con el Level de cada feature:
               INSTALL_X = "1"  -> casilla marcada  -> feature Level="1"  (instalada)
               INSTALL_X ≠ "1"  -> casilla vacía    -> feature Level="101" (no instalada)
             Estas propiedades solo viven en la UI; OptionsDlg.Next las
             traduce a ADDLOCAL/REMOVE con eventos AddLocal/Remove.
             INSTALL_STARTUP no se declara a propósito: en WiX un <Property>
             sin Value se ignora (CNDL1006) y Value="" es un error (CNDL0006),
             así que «desmarcado por defecto» = propiedad indefinida, que es
             como la lee el checkbox.
             INSTALL_STARTMENU ya no existe: el acceso directo de menú
             inicio lo aporta el paquete sparse (uap:VisualElements con
             AppListEntry por defecto, necesario para que la barra de tareas
             tenga icono); un shortcut del MSI aquí DUPLICARÍA la entrada. -->
        <Property Id="INSTALL_DESKTOP" Value="1" />

        {{#if allow_downgrades}}
            <MajorUpgrade Schedule="afterInstallInitialize" AllowDowngrades="yes" />
        {{else}}
            <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="!(loc.DowngradeErrorMessage)" AllowSameVersionUpgrades="yes" />
        {{/if}}

        <InstallExecuteSequence>
            <RemoveShortcuts>Installed AND NOT UPGRADINGPRODUCTCODE</RemoveShortcuts>
        </InstallExecuteSequence>

        <Media Id="1" Cabinet="app.cab" EmbedCab="yes" />

        {{#if banner_path}}
        <WixVariable Id="WixUIBannerBmp" Value="{{banner_path}}" />
        {{/if}}
        {{#if dialog_image_path}}
        <WixVariable Id="WixUIDialogBmp" Value="{{dialog_image_path}}" />
        {{/if}}
        {{#if license}}
        <WixVariable Id="WixUILicenseRtf" Value="{{license}}" />
        {{/if}}

        <Icon Id="ProductIcon" SourceFile="{{icon_path}}"/>
        <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
        <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />      <!-- Remove repair -->
        <SetProperty Id="ARPNOMODIFY" Value="1" After="InstallValidate" Sequence="execute"/>

        {{#if homepage}}
        <Property Id="ARPURLINFOABOUT" Value="{{homepage}}"/>
        <Property Id="ARPHELPLINK" Value="{{homepage}}"/>
        <Property Id="ARPURLUPDATEINFO" Value="{{homepage}}"/>
        {{/if}}

        <!-- NOTE: The order of RegistrySearch elements below matters. In WIX, when multiple
             RegistrySearch elements are listed under a single Property, the LAST successful
             match wins. We list the NSIS default-key search first and the MSI InstallDir
             search second so that the MSI-specific path takes priority when both keys exist. -->
        <Property Id="INSTALLDIR">
          <!-- Nota: NO se busca la clave legacy "Software\...\SoundWave" (nombre
               anterior del producto): preservarla hacia a instalar las
               versiones nuevas en la carpeta con el nombre viejo. La carpeta
               anterior la limpia el MajorUpgrade con el INSTALLDIR que el
               producto antiguo tenía registrado. -->
          <!-- First attempt: Search for the default key value (this is how the nsis installer stores the path) -->
          <RegistrySearch Id="PrevInstallDirNoName" Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}" Type="raw" />

          <!-- Second attempt: Search for "InstallDir" which takes priority if found (this is how the msi installer stores the path) -->
          <RegistrySearch Id="PrevInstallDirWithName" Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}" Name="InstallDir" Type="raw" />
        </Property>

        <!-- launch app checkbox -->
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchApp)" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1"/>
        <CustomAction Id="LaunchApplication" Impersonate="yes" FileKey="Path" ExeCommand="[LAUNCHAPPARGS]" Return="asyncNoWait" />

        <UI>
            <!-- launch app checkbox -->
            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>

            <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

            {{#unless license}}
            <!-- Skip license dialog -->
            <Publish Dialog="WelcomeDlg"
                     Control="Next"
                     Event="NewDialog"
                     Value="InstallDirDlg"
                     Order="2">1</Publish>
            <Publish Dialog="InstallDirDlg"
                     Control="Back"
                     Event="NewDialog"
                     Value="WelcomeDlg"
                     Order="2">1</Publish>
            {{/unless}}

            <!-- Flujo: InstallDirDlg -> OptionsDlg -> VerifyReadyDlg.
                 En InstallDirDlg.Next, WixUI_InstallDir ya publica
                 SetTargetPath(1) / DoAction(2) / SpawnDialog InvalidDirDlg(3)
                 / NewDialog VerifyReadyDlg(4); nuestro Order="5" gana el
                 NewDialog y mantiene la misma condición de ruta válida. -->
            <Publish Dialog="InstallDirDlg"
                     Control="Next"
                     Event="NewDialog"
                     Value="OptionsDlg"
                     Order="5"><![CDATA[WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"]]></Publish>

            <!-- VerifyReadyDlg.Back: WixUI publica Order="1" (InstallDirDlg) y
                 Order="2" (MaintenanceTypeDlg); Order="3" gana. -->
            <Publish Dialog="VerifyReadyDlg"
                     Control="Back"
                     Event="NewDialog"
                     Value="OptionsDlg"
                     Order="3">NOT Installed</Publish>

            <!-- "Cambiar" (modo mantenimiento): WixUI_InstallDir solo publica
                 WixUI_InstallMode=Change (Order 1) y NO navega (los sabores
                 Mondo/FeatureTree van a CustomizeDlg; aquí nadie publica el
                 NewDialog), así que el botón quedaba muerto. Lo mandamos a
                 OptionsDlg (Order 2, tras fijar el modo): desde ahí Next vuelve
                 a VerifyReadyDlg y las casillas publican AddLocal/Remove, que el
                 ejecutor procesa en modo Change (condición ALLUSERS AND
                 ADDLOCAL OR REMOVE del propio WixUI). -->
            <Publish Dialog="MaintenanceTypeDlg"
                     Control="ChangeButton"
                     Event="NewDialog"
                     Value="OptionsDlg"
                     Order="2">1</Publish>

            <!-- ── Diálogo OptionsDlg: accesos directos ────────────────────── -->
            <Dialog Id="OptionsDlg" Width="370" Height="270" Title="!(loc.OptionsDlg_Title)">
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.OptionsDlgDescription)" />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.OptionsDlgTitle)" />
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.OptionsDlgBannerBitmap)" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

                <Control Id="DesktopCheck" Type="CheckBox" X="20" Y="56" Width="330" Height="18" CheckBoxValue="1" Property="INSTALL_DESKTOP" Text="!(loc.OptionsDlgDesktop)" />
                <Control Id="StartupCheck" Type="CheckBox" X="20" Y="82" Width="330" Height="18" CheckBoxValue="1" Property="INSTALL_STARTUP" Text="!(loc.OptionsDlgStartup)" />
                <Control Id="StartupHint" Type="Text" X="32" Y="104" Width="310" Height="30" Transparent="yes" NoPrefix="yes" Text="!(loc.OptionsDlgStartupHint)" />
                <Control Id="DataNote" Type="Text" X="20" Y="140" Width="330" Height="46" Transparent="yes" NoPrefix="yes" Text="!(loc.OptionsDlgNote)" />

                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
                    <!-- La UI traduce las casillas en selección de features:
                         todos los eventos con condición cierta se lanzan en
                         orden ascendente (AddLocal/Remove) y el NewDialog
                         publicado con el mayor Order ("10") cierra el
                         diálogo al final. -->
                    <Publish Event="AddLocal" Value="DesktopShortcut" Order="1"><![CDATA[INSTALL_DESKTOP = "1"]]></Publish>
                    <Publish Event="Remove" Value="DesktopShortcut" Order="2"><![CDATA[INSTALL_DESKTOP <> "1"]]></Publish>
                    <Publish Event="AddLocal" Value="StartupShortcut" Order="3"><![CDATA[INSTALL_STARTUP = "1"]]></Publish>
                    <Publish Event="Remove" Value="StartupShortcut" Order="4"><![CDATA[INSTALL_STARTUP <> "1"]]></Publish>
                    <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="10">1</Publish>
                </Control>
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
                    <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
                <!-- WiX 3.14 no admite <TabOrder> (error CNDL0005): el orden
                     de tabulación es el orden de los controles, que ya deja
                     las casillas primero y después Next, Back y Cancel, igual
                     que en los diálogos de WixUI. -->
            </Dialog>
        </UI>

        <UIRef Id="WixUI_InstallDir" />

        <!-- Textos de estado de la pagina de progreso: aporta la tabla
             ActionText («Copiando archivos nuevos», «Archivo: [1], directorio:
             [9], tamano: [6]»...) sin la cual la linea "Estado:" del
             ProgressDlg se queda vacia durante la instalacion. -->
        <UIRef Id="WixUI_ErrorProgressText" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="DesktopFolder" Name="Desktop">
                <Component Id="ApplicationShortcutDesktop" Guid="*">
                    <Shortcut Id="ApplicationDesktopShortcut" Name="{{product_name}}" Description="Reproductor y descargador de música" Target="[!Path]" WorkingDirectory="INSTALLDIR" />
                    <RemoveFolder Id="DesktopFolder" On="uninstall" />
                    <RegistryValue Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}" Name="Desktop Shortcut" Type="integer" Value="1" KeyPath="yes" />
                </Component>
            </Directory>
            <Directory Id="$(var.PlatformProgramFilesFolder)" Name="PFiles">
                <Directory Id="INSTALLDIR" Name="{{product_name}}"/>
            </Directory>
            <!-- El acceso directo de menú inicio del MSI se ELIMINÓ (feature
                 StartMenuShortcut): la entrada en Inicio la aporta el paquete
                 sparse con AppListEntry por defecto — el shortcut del MSI
                 duplicaba «OpenWave» y, además, AppListEntry="none" dejaba la
                 barra de tareas SIN icono (sin ítem en AppsFolder no hay
                 icono que resolver). La carpeta de menú SOLO se declara para
                 CMP_LegacyStartCleanup (ver abajo): no se crea ni se pone en
                 ninguna feature. -->
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="{{product_name}}"/>
            </Directory>
            <!-- «Datos de Programas»: raíz de datos de la app (base de datos,
                 descargas, log). CommonAppDataFolder = C:\ProgramData (el Id
                 estándar es ese; «ProgramDataFolder» NO existe y MSI lo
                 resolvería como C:\CommonAppData). La carpeta se crea aquí
                 (CMP_DataDir) y la ACL la aplica la SAC FixAcl ver abajo: si
                 la creara la app en su primer arranque elevado, los ficheros
                 heredarían solo «Usuarios: leer y ejecutar» y el proceso
                 normal no podría escribir (PermissionError reproducido). -->
            <Directory Id="CommonAppDataFolder" Name="CommonAppData">
                <Directory Id="OPENWAVEDATADIR" Name="OpenWave"/>
            </Directory>
            <!-- Carpeta de la SAC FixAcl (icacls): System64Folder/SystemFolder
                 según BUILDARCH (ambos contienen icacls.exe). Es un directorio
                 con propiedad estándar: el Name se ignora, la ruta la da la
                 propiedad (C:\Windows\System32\). -->
            <Directory Id="$(var.IcaclsFolderId)" Name="System32"/>
        </Directory>

        <DirectoryRef Id="INSTALLDIR">
            <Component Id="RegistryEntries" Guid="*">
                <RegistryKey Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}">
                    <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
                </RegistryKey>
                <!-- AppUserModelID (com.soundwave.app): nombre/icono para
                     lo que resuelve por AUMID (accesos directos en la barra
                     de tareas). La AGRUPACION en el Administrador de Tareas
                     ya NO depende de esto: la da la identidad de paquete
                     sparse (SAC RegisterIdentity + elemento <msix> del exe;
                     el AUMID explicito no basto — bug #5628, ver
                     docs/PERFORMANCE.md §10). La clave va en literal porque
                     {{bundle_id}} NO existe en el contexto handlebars de
                     Tauri (quedaría sin interpolar); el identifier es
                     estable por decisión (ver README). -->
                <RegistryKey Root="HKCU" Key="Software\Classes\AppUserModelId\com.soundwave.app">
                    <RegistryValue Name="DisplayName" Type="string" Value="{{product_name}}" />
                    <RegistryValue Name="IconUri" Type="string" Value="[!Path]" />
                    <RegistryValue Name="IconBackgroundColor" Type="string" Value="#0a0a0f" />
                </RegistryKey>
                <!-- Change the Root to HKCU for perUser installations -->
                {{#each deep_link_protocols as |protocol| ~}}
                <RegistryKey Root="HKLM" Key="Software\Classes\\{{protocol}}">
                    <RegistryValue Type="string" Name="URL Protocol" Value=""/>
                    <RegistryValue Type="string" Value="URL:{{bundle_id}} protocol"/>
                    <RegistryKey Key="DefaultIcon">
                        <RegistryValue Type="string" Value="&quot;[!Path]&quot;,0" />
                    </RegistryKey>
                    <RegistryKey Key="shell\open\command">
                        <RegistryValue Type="string" Value="&quot;[!Path]&quot; &quot;%1&quot;" />
                    </RegistryKey>
                </RegistryKey>
                {{/each~}}
            </Component>
            <Component Id="Path" Guid="{{path_component_guid}}" Win64="$(var.Win64)">
                <File Id="Path" Source="{{main_binary_path}}" KeyPath="yes" Checksum="yes"/>
                <!-- Limpieza de INSTALLDIR: vive aquí (feature siempre
                     instalada) para que la carpeta se borre en la
                     desinstalación aunque el Menú Inicio estuviera desmarcado. -->
                <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
                {{#each file_associations as |association| ~}}
                {{#each association.ext as |ext| ~}}
                <ProgId Id="{{../../product_name}}.{{ext}}" Advertise="yes" Description="{{association.description}}">
                    <Extension Id="{{ext}}" Advertise="yes">
                        <Verb Id="open" Command="Open with {{../../product_name}}" Argument="&quot;%1&quot;" />
                    </Extension>
                </ProgId>
                {{/each~}}
                {{/each~}}
            </Component>
            {{#each binaries as |bin| ~}}
            <Component Id="{{ bin.id }}" Guid="{{bin.guid}}" Win64="$(var.Win64)">
                <File Id="Bin_{{ bin.id }}" Source="{{bin.path}}" KeyPath="yes"/>
            </Component>
            {{/each~}}
            {{#if enable_elevated_update_task}}
            <Component Id="UpdateTask" Guid="C492327D-9720-4CD5-8DB8-F09082AF44BE" Win64="$(var.Win64)">
                <File Id="UpdateTask" Source="update.xml" KeyPath="yes" Checksum="yes"/>
            </Component>
            <Component Id="UpdateTaskInstaller" Guid="011F25ED-9BE3-50A7-9E9B-3519ED2B9932" Win64="$(var.Win64)">
                <File Id="UpdateTaskInstaller" Source="install-task.ps1" KeyPath="yes" Checksum="yes"/>
            </Component>
            <Component Id="UpdateTaskUninstaller" Guid="D4F6CC3F-32DC-5FD0-95E8-782FFD7BBCE1" Win64="$(var.Win64)">
                <File Id="UpdateTaskUninstaller" Source="uninstall-task.ps1" KeyPath="yes" Checksum="yes"/>
            </Component>
            {{/if}}
            {{resources}}
            <Component Id="CMP_UninstallShortcut" Guid="*">
                <Shortcut Id="UninstallShortcut"
                          Name="Desinstalar {{product_name}}"
                          Description="Desinstala {{product_name}} del equipo"
                          Target="[System64Folder]msiexec.exe"
                          Arguments="/x [ProductCode]" />
                <RegistryValue Root="HKCU"
                               Key="Software\\{{manufacturer}}\\{{product_name}}"
                               Name="Uninstaller Shortcut"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
            <!-- «Iniciar con Windows»: entrada Run de HKCU (solo este
                 usuario, sin archivos sueltos). Idéntico patrón de keypath
                 HKCU que los accesos directos de Tauri. -->
            <Component Id="CMP_StartupRun" Guid="*" Win64="$(var.Win64)">
                <RegistryValue Root="HKCU"
                               Key="Software\Microsoft\Windows\CurrentVersion\Run"
                               Name="{{product_name}}"
                               Type="string"
                               Value="&quot;[!Path]&quot;"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Limpieza del acceso directo de menú inicio HEREDADO de las
             versiones previas del MSI (feature StartMenuShortcut, ya
             eliminada). Hace falta autorarla en el producto NUEVO porque en un
             upgrade RemoveExistingProducts desinstala el producto viejo con la
             secuencia de ESA versión (RemoveShortcuts = Installed AND NOT
             UPGRADINGPRODUCTCODE -> false): su .lnk queda huérfano para
             siempre y duplicaría «OpenWave» en Start. Por eso la limpieza va
             AQUÍ, en modo install (RemoveFiles corre tambien en instalacion
             fresca; ver msi-install-icon.log sesion 00:8C). Si la borra el
             producto nuevo, la carpeta (foreign, sin CreateFolder) se elimina
             solo si queda vacia: el Id de la fila del .lnk va con prefijo A_
             y el de la carpeta Z_ para que el orden de la tabla RemoveFile
             (FileKey) procese el .lnk ANTES. -->
        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="CMP_LegacyStartCleanup" Guid="*">
                <RemoveFile Id="A_RemoveLegacyStartLnk" Name="*.lnk" DirProperty="ApplicationProgramsFolder" On="install" />
                <RemoveFolder Id="Z_RemoveLegacyStartFolder" On="install" />
                <RegistryValue Root="HKCU"
                               Key="Software\\{{manufacturer}}\\{{product_name}}"
                               Name="Legacy Start Menu Cleanup"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Carpeta de datos. CreateFolder solo la retira si queda VACÍA en
             la desinstalación: los datos sobreviven. (Guid explícito: un
             componente con keypath de directorio no admite «*» — LGHT0230.) -->
        <DirectoryRef Id="OPENWAVEDATADIR">
            <Component Id="CMP_DataDir" Guid="{57F4FEA7-6905-44A6-94CB-751B243D5AD7}" Win64="$(var.Win64)">
                <CreateFolder />
            </Component>
        </DirectoryRef>

        <!-- ACL de la carpeta de datos, locale-proof. La aplica icacls con
             SID (*S-1-5-32-545 = BUILTIN\Users): util:PermissionEx solo
             admite nombres de cuenta y esos están localizados («Usuarios»
             en es-ES, «Users» en en-US) — y con el SID dentro de
             PermissionEx da «failed to get sid for account» → 1603. (OI)(CI)
             hereda el
             permiso también a los FICHEROS (los creados por un arranque
             elevado quedaban de solo lectura para el usuario: PermissionError
             en openwave.log, reproducido) y /T sanear además los ya
             existentes. SAC diferido, elevado (Impersonate=no), solo en
             instalación/reparación (NOT REMOVE) y Return=ignore: si icacls
             fallara, la instalación no se rompe (lo verifica
             scripts/verify-msi.ps1 + el post-install-check). -->
        <CustomAction Id="SetFixAclData" Property="CustomActionData" Value="[CommonAppDataFolder]OpenWave" />
        <CustomAction Id="FixAcl"
                      Directory="$(var.IcaclsFolderId)"
                      ExeCommand="icacls.exe &quot;[CustomActionData]&quot; /grant:r *S-1-5-32-545:(OI)(CI)M /T /C /Q"
                      Execute="deferred" Return="ignore" Impersonate="no" />
        <InstallExecuteSequence>
            <Custom Action="SetFixAclData" Before="FixAcl" />
            <Custom Action="FixAcl" After="CreateFolders">NOT REMOVE</Custom>
        </InstallExecuteSequence>

        <!-- ── Identidad de paquete sparse (plan C: agrupacion en TV) ──────
             openwave-identity.msix/.cer y el script openwave-identity-ca.ps1
             llegan al INSTALLDIR via bundle.resources (tauri.conf.json).
             La SAC NO pega el comando en linea: llama al script -File (el
             inline -Command fallaba solo dentro de msiexec: exit 1 sin
             ejecutar Remove/Add; verificado 2026-10-05, y el detalle en
             openwave-identity.log). El script importa la confianza del
             certificado al usuario que instala (sin ella Add-AppxPackage
             da 0x800B0109) y registra el paquete con -ExternalLocation =
             su propia carpeta: OpenWave.exe (con el elemento <msix> que
             embebe build.rs) y sus hijos WebView2 comparten identidad y
             el Administrador de Tareas los agrupa en UN solo grupo
             «OpenWave» con el icono original (sin esto, hijos de WebView2
             en «Administrador de WebView2»: bug
             MicrosoftEdge/WebView2Feedback#5628). Remove-Add dentro del
             script hace la operacion idempotente y actualiza la
             ExternalLocation en reparaciones y upgrades (con la misma
             version sin remover daria 0x80073CF9).
             Return=ignore: si AppX fallara (p.ej. policy de equipo que
             bloqueie despliegues), la instalacion NO se rompe; la app
             quedaria sin identidad y verify-msi lo detecta en el chequeo
             en vivo. Register va inmediata tras InstallFinalize (ficheros
             ya en disco) y Unregister ANTES de RemoveFiles (el script
             tiene que existir todavia); ambas imperadas por el usuario
             que instala (los CAs inmediados corren en su contexto:
             HKCU/Cert:\CurrentUser sin elevacion).
             -ExecutionPolicy Bypass: por si el equipo restringe scripts. -->
        <CustomAction Id="RegisterIdentity"
                      Directory="$(var.IcaclsFolderId)"
                      ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -NonInteractive -WindowStyle Hidden -File &quot;[INSTALLDIR]openwave-identity-ca.ps1&quot; -Mode Register"
                      Return="ignore" />
        <CustomAction Id="UnregisterIdentity"
                      Directory="$(var.IcaclsFolderId)"
                      ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -NonInteractive -WindowStyle Hidden -File &quot;[INSTALLDIR]openwave-identity-ca.ps1&quot; -Mode Unregister"
                      Return="ignore" />
        <InstallExecuteSequence>
            <Custom Action="RegisterIdentity" After="InstallFinalize">NOT REMOVE</Custom>
            <!-- Antes de RemoveFiles: el script -Mode Unregister tiene que
                 seguir en disco (RemoveFiles borra los ficheros ANTES de
                 InstallFinalize, asi que tras InstallFinalize ya no estaria). -->
            <Custom Action="UnregisterIdentity" Before="RemoveFiles">(REMOVE = "ALL") AND NOT UPGRADINGPRODUCTCODE</Custom>
        </InstallExecuteSequence>

        {{#each merge_modules as |msm| ~}}
        <DirectoryRef Id="TARGETDIR">
            <Merge Id="{{ msm.name }}" SourceFile="{{ msm.path }}" DiskId="1" Language="!(loc.TauriLanguage)" />
        </DirectoryRef>

        <Feature Id="{{ msm.name }}" Title="{{ msm.name }}" AllowAdvertise="no" Display="hidden" Level="1">
            <MergeRef Id="{{ msm.name }}"/>
        </Feature>
        {{/each~}}

        <!-- Features:
             MainProgram        -> imprescindible (exe + recursos + registro
                                   + shortcut «Desinstalar» en INSTALLDIR)
               DesktopShortcut  -> Level 1   (por defecto SÍ)
               StartupShortcut  -> Level 101 (> INSTALLLEVEL: por defecto NO)
               Environment      -> como en Tauri (referencia doble de Path)
             NO hay feature StartMenuShortcut: la entrada en el menú Inicio
             la da el paquete sparse (AppListEntry por defecto). -->
        <Feature
                Id="MainProgram"
                Title="Application"
                Description="!(loc.InstallAppFeature)"
                Level="1"
                ConfigurableDirectory="INSTALLDIR"
                AllowAdvertise="no"
                Display="expand"
                Absent="disallow">

            <ComponentRef Id="RegistryEntries"/>
            <!-- El .exe se instala SIEMPRE: las casillas solo añaden o
                 quitan accesos directos, nunca la aplicación. -->
            <ComponentRef Id="Path"/>
            <!-- Datos en «Datos de Programas» (con su ACL): siempre. -->
            <ComponentRef Id="CMP_DataDir"/>
            <!-- Shortcut «Desinstalar OpenWave» en INSTALLDIR (antes estaba
                 en la feature StartMenuShortcut, eliminada). -->
            <ComponentRef Id="CMP_UninstallShortcut"/>
            <!-- Limpieza del .lnk de menú inicio que dejó el MSI antiguo
                 (huérfano en upgrades: ver CMP_LegacyStartCleanup). -->
            <ComponentRef Id="CMP_LegacyStartCleanup"/>

            {{#each resource_file_ids as |resource_file_id| ~}}
                <ComponentRef Id="{{ resource_file_id }}"/>
            {{/each~}}

            {{#if enable_elevated_update_task}}
                <ComponentRef Id="UpdateTask" />
                <ComponentRef Id="UpdateTaskInstaller" />
                <ComponentRef Id="UpdateTaskUninstaller" />
            {{/if}}

            <Feature Id="DesktopShortcut"
                Title="!(loc.FeatureDesktop)"
                Level="1"
                Absent="allow">
                <ComponentRef Id="ApplicationShortcutDesktop" />
            </Feature>

            <Feature Id="StartupShortcut"
                Title="!(loc.FeatureStartup)"
                Level="101"
                Absent="allow">
                <ComponentRef Id="CMP_StartupRun" />
            </Feature>

            <Feature
                Id="Environment"
                Title="PATH Environment Variable"
                Description="!(loc.PathEnvVarFeature)"
                Level="1"
                Absent="allow">
            <ComponentRef Id="Path"/>
            {{#each binaries as |bin| ~}}
            <ComponentRef Id="{{ bin.id }}"/>
            {{/each~}}
            </Feature>
        </Feature>

        <Feature Id="External" AllowAdvertise="no" Absent="disallow">
            {{#each component_group_refs as |id| ~}}
            <ComponentGroupRef Id="{{ id }}"/>
            {{/each~}}
            {{#each component_refs as |id| ~}}
            <ComponentRef Id="{{ id }}"/>
            {{/each~}}
            {{#each feature_group_refs as |id| ~}}
            <FeatureGroupRef Id="{{ id }}"/>
            {{/each~}}
            {{#each feature_refs as |id| ~}}
            <FeatureRef Id="{{ id }}"/>
            {{/each~}}
            {{#each merge_refs as |id| ~}}
            <MergeRef Id="{{ id }}"/>
            {{/each~}}
        </Feature>

        {{#if install_webview}}
        <!-- WebView2 -->
        <Property Id="INSTALLED_WEBVIEW2_VERSION">
            <RegistrySearch Id="Webview2VersionSystemx64" Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
            <RegistrySearch Id="Webview2VersionSystemx86" Root="HKLM" Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
            <RegistrySearch Id="Webview2VersionUser" Root="HKCU" Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw"/>
        </Property>

        {{#if download_bootstrapper}}
        <!-- Download webview bootstrapper mode -->
        <CustomAction Id='DownloadAndInvokeBootstrapper' Directory="INSTALLDIR" Execute="deferred" ExeCommand='powershell.exe -NoProfile -windowstyle hidden try [\{] [\[]Net.ServicePointManager[\]]::SecurityProtocol = [\[]Net.SecurityProtocolType[\]]::Tls12 [\}] catch [\{][\}]; Invoke-WebRequest -Uri "https://go.microsoft.com/fwlink/p/?LinkId=2124703" -OutFile "$env:TEMP\MicrosoftEdgeWebview2Setup.exe" ; Start-Process -FilePath "$env:TEMP\MicrosoftEdgeWebview2Setup.exe" -ArgumentList ({{webview_installer_args}} &apos;/install&apos;) -Wait' Return='check'/>
        <InstallExecuteSequence>
            <Custom Action='DownloadAndInvokeBootstrapper' Before='InstallFinalize'>
                <![CDATA[NOT(REMOVE OR INSTALLED_WEBVIEW2_VERSION)]]>
            </Custom>
        </InstallExecuteSequence>
        {{/if}}

        {{#if webview2_bootstrapper_path}}
        <!-- Embedded webview bootstrapper mode -->
        <Binary Id="MicrosoftEdgeWebview2Setup.exe" SourceFile="{{webview2_bootstrapper_path}}"/>
        <CustomAction Id='InvokeBootstrapper' BinaryKey='MicrosoftEdgeWebview2Setup.exe' Execute="deferred" ExeCommand='{{webview_installer_args}} /install' Return='check' />
        <InstallExecuteSequence>
            <Custom Action='InvokeBootstrapper' Before='InstallFinalize'>
                <![CDATA[NOT(REMOVE OR INSTALLED_WEBVIEW2_VERSION)]]>
            </Custom>
        </InstallExecuteSequence>
        {{/if}}

        {{#if webview2_installer_path}}
        <!-- Embedded offline installer -->
        <Binary Id="MicrosoftEdgeWebView2RuntimeInstaller.exe" SourceFile="{{webview2_installer_path}}"/>
        <CustomAction Id='InvokeStandalone' BinaryKey='MicrosoftEdgeWebView2RuntimeInstaller.exe' Execute="deferred" ExeCommand='{{webview_installer_args}} /install' Return='check' />
        <InstallExecuteSequence>
            <Custom Action='InvokeStandalone' Before='InstallFinalize'>
                <![CDATA[NOT(REMOVE OR INSTALLED_WEBVIEW2_VERSION)]]>
            </Custom>
        </InstallExecuteSequence>
        {{/if}}

        {{#if minimum_webview2_version}}
        <!-- Update WebView2 if minimum version requirement not met -->
        <Property Id="MINIMUM_WEBVIEW2_VERSION" Value="{{minimum_webview2_version}}" />
        <Property Id="EDGEUPDATE_PATH">
            <RegistrySearch Id="EdgeUpdateLocalMachine64" Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate" Name="path" Type="raw" />
            <RegistrySearch Id="EdgeUpdateLocalMachine32" Root="HKLM" Key="SOFTWARE\Microsoft\EdgeUpdate" Name="path" Type="raw"/>
            <RegistrySearch Id="EdgeUpdateCurrentUser" Root="HKCU" Key="SOFTWARE\Microsoft\EdgeUpdate" Name="path" Type="raw"/>
        </Property>
        <!-- Chromium updater docs: https://source.chromium.org/chromium/chromium/src/+/main:docs/updater/user_manual.md -->
        <!-- Modified from "HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Microsoft EdgeWebView\ModifyPath" -->
        <CustomAction Id="UpdateWebView2ViaEdgeUpdate" Execute="deferred" Property="EDGEUPDATE_PATH" Return="check" Impersonate="no" ExeCommand="/install appguid={F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}&amp;needsadmin=true" />
        <InstallExecuteSequence>
            <Custom Action='UpdateWebView2ViaEdgeUpdate' Before='InstallFinalize'>
                <![CDATA[
                  NOT REMOVE
                  AND INSTALLED_WEBVIEW2_VERSION
                  AND (INSTALLED_WEBVIEW2_VERSION < MINIMUM_WEBVIEW2_VERSION)
                ]]>
            </Custom>
        </InstallExecuteSequence>
        {{/if}}

        {{/if}}

        {{#if enable_elevated_update_task}}
        <!-- Install an elevated update task within Windows Task Scheduler -->
        <CustomAction
            Id="CreateUpdateTask"
            Return="check"
            Directory="INSTALLDIR"
            Execute="commit"
            Impersonate="yes"
            ExeCommand="powershell.exe -WindowStyle hidden .\install-task.ps1" />
        <InstallExecuteSequence>
            <Custom Action='CreateUpdateTask' Before='InstallFinalize'>
                NOT(REMOVE)
            </Custom>
        </InstallExecuteSequence>
        <!-- Remove elevated update task during uninstall -->
        <CustomAction
            Id="DeleteUpdateTask"
            Return="check"
            Directory="INSTALLDIR"
            ExeCommand="powershell.exe -WindowStyle hidden .\uninstall-task.ps1" />
        <InstallExecuteSequence>
            <Custom Action="DeleteUpdateTask" Before='InstallFinalize'>
                (REMOVE = "ALL") AND NOT UPGRADINGPRODUCTCODE
            </Custom>
        </InstallExecuteSequence>
        {{/if}}

        <InstallExecuteSequence>
          <Custom Action="LaunchApplication" After="RegisterIdentity">AUTOLAUNCHAPP AND NOT Installed</Custom>
        </InstallExecuteSequence>

        <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize"/>
    </Product>
</Wix>
